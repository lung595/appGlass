#!/usr/bin/sh
# appglass-localsend: start the LocalSend flatpak with a glass window.
# appglass-ck.so (LD_PRELOAD, one-off read-only --filesystem, no flatpak override) colour-keys LocalSend's
# own background colours to the DMS glass levels. Keys are for LocalSend's default palette (ls_color
# "localsend"); the theme is LocalSend's own setting (ls_theme), else the system colour scheme, else DMS mode.
# APPGLASS_SCRUB (empty: nothing beyond the shim and its keys) keeps them out of what LocalSend starts.
# Undo: rm ~/.local/bin/appglass-localsend ~/.local/share/applications/org.localsend.localsend_app.desktop
#       rm -r ~/.local/lib/appglass/localsend
set -u
LIB="$HOME/.local/lib/appglass/localsend"
ID=org.localsend.localsend_app
PREFS="$HOME/.var/app/$ID/data/$ID/shared_preferences.json"
COLORS="${XDG_CACHE_HOME:-$HOME/.cache}/dms/dms-colors.json"
plain() { exec /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=localsend --file-forwarding "$ID" @@u "$@" @@; }
# the engine (appglass verify, launch-check): a plain/ marker means start the plain app
AGKEY="$ID"
[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/appglass/plain/$AGKEY" ] && plain "$@"
[ -f "$LIB/appglass-ck.so" ] || plain "$@"
lv=$("@APPGLASS@" levels 2>/dev/null) || lv=''
[ -n "$lv" ] || lv='{"content":0.6,"bar":0.65}'
c=$(printf '%s' "$lv" | jq -r '.content')
b=$(printf '%s' "$lv" | jq -r '.bar')
theme=$(jq -r '."flutter.ls_theme" // "system"' "$PREFS" 2>/dev/null) || theme=system
case "$theme" in *light*) mode=light ;; *dark*) mode=dark ;; *)
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
        *prefer-dark*) mode=dark ;; *prefer-light*) mode=light ;;
        *) mode=$(jq -r '.mode // "dark"' "$COLORS" 2>/dev/null) || mode=dark ;;
    esac ;;
esac
pal=$(jq -r '."flutter.ls_color" // "localsend"' "$PREFS" 2>/dev/null) || pal=localsend
[ "$pal" = localsend ] || echo "appglass-localsend: colour '$pal' is not the default palette, keys may not match" >&2
# colour keys are data (~/.cache/appglass/keys/<app>/<version>/<mode>.json): none, no glass
keys=$("@APPGLASS@" keys "$ID" "$mode" 2>/dev/null) && [ -n "$keys" ] || plain "$@"
# two launches with no window on this app version: the engine pauses the glass
command -v setsid >/dev/null 2>&1 && setsid -f "@APPGLASS@" launch-check "$AGKEY" $$ \
    >/dev/null 2>&1 </dev/null
exec /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=localsend --file-forwarding \
    --filesystem="$LIB:ro" --env=LD_PRELOAD="$LIB/appglass-ck.so" --env=APPGLASS_KEYS="$keys" --env=APPGLASS_SCRUB= \
    "$ID" @@u "$@" @@

/* appGlass for Feishin, injected as a user stylesheet by agl-hook.js (window background cleared by the hook).
   Generated at launch by appglass-feishin from the DMS colours and `appglass levels`.
   Content painted once on #root, bars over it, menus/modals opaque, text untouched. */
html, body, [id$="-layout"], [class*="layout-module"], [class*="main-content"], [class*="route"], [class*="page-module"],
[class*="native-scroll"], [class*="scroll-area"], [class*="library-header"] { background: transparent !important; }
#root { background: rgba({{surface}}, {{content}}) !important; }
#player-bar, [class*="player-bar-module"], [class*="page-header-module-container"], [class*="sidebar"], [class*="titlebar"], [class*="window-bar"], [class*="top-bar"]
{ background: rgba({{surface_container}}, {{bar_over}}) !important; }
section[class*="modal"], [class*="mantine-Menu-dropdown"], [class*="mantine-Popover-dropdown"], [class*="mantine-Select-dropdown"],
[class*="mantine-Tooltip"], [class*="context-menu"], [class*="mantine-Notification-root"]
{ background: rgb({{surface_container_high}}) !important; }

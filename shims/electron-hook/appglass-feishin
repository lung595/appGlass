#!/usr/bin/sh
# appglass-feishin: start the Feishin flatpak with a glass window.
# Feishin is started through its normal flatpak command (zypak sandbox kept) with a Node inspector on
# 127.0.0.1, a random port and --inspect-publish-uid=stderr: the inspector target is NOT listed over
# HTTP, so a client needs the random session UUID printed on the app's stderr, which only this wrapper
# reads (a 0700 dir in a private XDG_RUNTIME_DIR, else no inspector at all; the url file is deleted
# after the injection attempt, whatever its result). agl-inject.py requires agl-hook.js in the main process
# (clear window background + glass CSS from AGL_CSS), then closes the inspector (user decision
# "Auto, port closed after": Node's inspector.close() once its session hung up, the port checked
# with a second connect). An Electron that cannot close it keeps it on 127.0.0.1, random port,
# its target unlisted. CSS generated at launch from DMS colours + levels.
# No flatpak override: the read-only --filesystem below is for this run only. Feishin's settings are not touched.
# Undo: rm ~/.local/bin/appglass-feishin ~/.local/share/applications/org.jeffvli.feishin.desktop
#       rm -r ~/.local/lib/appglass/feishin
set -u
LIB="$HOME/.local/lib/appglass/feishin"
ID=org.jeffvli.feishin
COLORS="${XDG_CACHE_HOME:-$HOME/.cache}/dms/dms-colors.json"
FP=/usr/bin/flatpak
[ -n "${APPGLASS_SANDBOX:-}" ] && [ -n "${APPGLASS_FLATPAK:-}" ] && FP=$APPGLASS_FLATPAK  # tests only
plain() { exec "$FP" run "$ID" "$@"; }
# the engine (appglass verify, launch-check): a plain/ marker means start the plain app
AGKEY="$ID"
[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/appglass/plain/$AGKEY" ] && plain "$@"
# a directory only we can write to (not a link): the inspector UUID is a secret
private_dir() {
    [ -n "$1" ] && [ -d "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] || return 1
    case $(stat -c %a "$1" 2>/dev/null || echo 2) in *[2367] | *[2367]?) return 1 ;; esac
}
# already running: Feishin is single-instance, just hand over
"$FP" ps --columns=application 2>/dev/null | grep -qx "$ID" && plain "$@"
[ -f "$LIB/agl-hook.js" ] && [ -f "$LIB/agl-inject.py" ] || plain "$@"
lv=$("@APPGLASS@" levels 2>/dev/null) || lv=''
[ -n "$lv" ] || lv='{"content":0.6,"bar_over_content":0.125}'
c=$(printf '%s' "$lv" | jq -r '.content')
b=$(printf '%s' "$lv" | jq -r '.bar_over_content')
mode=$(jq -r '.mode // "dark"' "$COLORS" 2>/dev/null) || mode=dark
rgb() {  # DMS colour key -> "r, g, b"
    h=$(jq -r --arg m "$mode" --arg k "$1" '.colors[$m][$k] // empty' "$COLORS" 2>/dev/null | tr -d '#')
    printf '%s' "$h" | grep -qxE '[0-9a-fA-F]{6}' || h=$2   # nothing else reaches sed
    printf '%d, %d, %d' "0x$(echo $h | cut -c1-2)" "0x$(echo $h | cut -c3-4)" "0x$(echo $h | cut -c5-6)"
}
css="$LIB/feishin-glass.css"
sed -e "s/{{content}}/$c/g" -e "s/{{bar_over}}/$b/g" \
    -e "s/{{surface}}/$(rgb surface 101418)/g" -e "s/{{surface_container}}/$(rgb surface_container 1e2226)/g" \
    -e "s/{{surface_container_high}}/$(rgb surface_container_high 282c30)/g" \
    "$LIB/feishin-glass.css.tmpl" > "$css.tmp" && mv -f "$css.tmp" "$css" || plain "$@"
# no /tmp fallback: without a private runtime dir Feishin runs without glass
private_dir "${XDG_RUNTIME_DIR:-}" || plain "$@"
RUN="$XDG_RUNTIME_DIR/appglass"
[ -e "$RUN" ] || mkdir -m 700 "$RUN" 2>/dev/null
private_dir "$RUN" || plain "$@"
# the app's output goes through a fifo to a reader that keeps only the inspector url (in the
# 0700 dir) and drops the rest, so no file grows in the tmpfs runtime dir while Feishin runs
fifo="$RUN/feishin.fifo"; out="$RUN/feishin.url"; rm -f "$fifo" "$out"
mkfifo -m 600 "$fifo" || plain "$@"
{ grep -m 1 -oE 'ws://127\.0\.0\.1:[0-9]+/[0-9a-f-]+' > "$out"; cat > /dev/null; } < "$fifo" &
"$FP" run --filesystem="$LIB:ro" --env=AGL_CSS="$css" \
    "$ID" --inspect=127.0.0.1:0 --inspect-publish-uid=stderr "$@" >"$fifo" 2>&1 &
pid=$!
# two launches with no window on this app version: the engine pauses the glass
command -v setsid >/dev/null 2>&1 && setsid -f "@APPGLASS@" launch-check "$AGKEY" $pid \
    >/dev/null 2>&1 </dev/null
i=0; url=''
while [ $i -lt 150 ] && kill -0 $pid 2>/dev/null; do
    url=$(head -n 1 "$out" 2>/dev/null)
    [ -n "$url" ] && break
    sleep 0.2; i=$((i + 1))
done
rm -f "$fifo"
if [ -n "$url" ]; then
    python3 -I "$LIB/agl-inject.py" "$url" "$LIB/agl-hook.js" >/dev/null 2>&1 ||
        echo "appglass-feishin: injection failed, running without glass" >&2
else
    echo "appglass-feishin: no inspector url, running without glass" >&2
fi
rm -f "$out"   # drop the session UUID either way
wait $pid

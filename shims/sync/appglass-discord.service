[Unit]
Description=appGlass: put Vencord back into a new Discord host
# Discord writes ~/.config/discord in bursts at start: a start limit hit
# here also fails the path unit (unit-start-limit-hit), so no limit
StartLimitIntervalSec=0
[Service]
Type=oneshot
ExecStart=%h/.local/bin/appglass-sync --discord
# Discord writes ~/.config/discord all the time and the check exits at once:
# keep its start/finish lines out of the journal (the script logs at notice)
LogLevelMax=notice

[Unit]
Description=appGlass: check the queued apps in a hidden headless session
[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
# an Electron or WebKit app alone can take more than 512M; an OOM kill
# there would end verify itself, the queue never done
MemoryMax=2G
# appglass verify stops starting checks after 25 min (verify.BUDGET); one
# app takes 90 s at most. A stop sends SIGTERM to verify alone: it SIGKILLs
# the hidden session and deletes its private dir; what is left then gets
# SIGKILL (a SIGTERM to headless gamescope makes it segfault)
TimeoutSec=30min
KillMode=mixed
ExecStart=%h/.local/bin/appglass-sync --verify

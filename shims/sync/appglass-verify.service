[Unit]
Description=appGlass: check the queued apps in a hidden headless session
[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
# appglass verify stops starting checks after 25 min (verify.BUDGET); one
# app takes 90 s at most. SIGTERM then kills the whole cgroup, the hidden
# session included, and verify deletes its private dir
TimeoutSec=30min
KillMode=control-group
ExecStart=%h/.local/bin/appglass-sync --verify

#!/usr/bin/sh
# appglass-webkit: start any WebKitGTK app (GTK3, WebKitGTK 4.x) with a glass window.
#   appglass-webkit <key> <command> [args...]      (the launcher overrides of the webkit family)
# appglass-wk.so (LD_PRELOAD) clears the WebView background, gives the window an RGBA visual and
# injects webkit-glass.css (the levels) and webkit-glass.js (marks the page by its own colours).
# Levels come from `appglass levels` (DMS) at every launch.
# Undo: appglass remove --only webkit
set -u
LIB="$HOME/.local/lib/appglass/webkit"
[ $# -ge 2 ] || { echo "usage: appglass-webkit <key> <command> [args...]" >&2; exit 2; }
AGKEY=$1; shift
# Exec=env VAR=val ... app: the shim keeps itself out of the children of the first process it
# loads in, so env would start the app plain. Plain assignments are made here and the app is
# started itself; anything else (an option, no command) is left to env.
case $1 in
env|*/env)
    found=0 n=0
    for a in "$@"; do
        n=$((n + 1)); [ $n -eq 1 ] && continue
        case $a in
            -*) break ;;
            *=*) k=${a%%=*}; case $k in ''|[0-9]*|*[!A-Za-z0-9_]*) break ;; esac ;;
            *) found=1; break ;;
        esac
    done
    if [ $found = 1 ]; then
        shift
        while :; do case $1 in *=*) export "$1"; shift ;; *) break ;; esac; done
    fi ;;
esac
plain() { exec "$@"; }
# the engine (appglass verify, launch-check): a plain/ marker means start the plain app
case $AGKEY in */*|.*|'') plain "$@" ;; esac
[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/appglass/plain/$AGKEY" ] && plain "$@"
lv=$("@APPGLASS@" levels 2>/dev/null) || lv=''
[ -n "$lv" ] || lv='{"content":0.6,"bar_over_content":0.125}'
c=$(printf '%s' "$lv" | jq -r '(.content * 1000 | round) / 10')
b=$(printf '%s' "$lv" | jq -r '(.bar_over_content * 1000 | round) / 10')
for v in "$c" "$b"; do printf '%s' "$v" | grep -qxE '[0-9]+(\.[0-9]+)?' || plain "$@"; done
css="$LIB/webkit-glass.css"
if [ -f "$LIB/appglass-wk.so" ] && [ -f "$LIB/webkit-glass.js" ] && sed -e "s/{{content}}/$c/g" -e "s/{{bar_over}}/$b/g" "$LIB/webkit-glass.css.tmpl" > "$css.$$.tmp" && mv -f "$css.$$.tmp" "$css"; then
# two launches with no window on this app version: the engine pauses the glass
command -v setsid >/dev/null 2>&1 && setsid -f "@APPGLASS@" launch-check "$AGKEY" $$ \
    >/dev/null 2>&1 </dev/null
    exec env LD_PRELOAD="$LIB/appglass-wk.so${LD_PRELOAD:+:$LD_PRELOAD}" APPGLASS_CSS="$css" \
        APPGLASS_JS="$LIB/webkit-glass.js" "$@"
fi
rm -f "$css.$$.tmp"
echo "appglass-webkit: shim missing, starting $1 without glass" >&2
plain "$@"

/* appGlass for any WebKitGTK app, injected as a WebKit USER stylesheet by appglass-wk.so.
   Rendered at launch by appglass-webkit: {{content}} / {{bar_over}}
   come from `appglass levels` (DMS). webkit-glass.js marks the elements with the page's own
   colours (light and dark both work). Text is never alpha'd; popups are never marked. */
/* content: the page colour, the only root with alpha */
html[data-agl-root] {
  background-color: color-mix(in srgb, rgb(var(--agl-root)) {{content}}%, transparent) !important;
  background-image: none !important; }
/* the page colour elsewhere (body, an app shell): clear, the content shows through */
html[data-agl-root] [data-agl="clear"] { background-color: transparent !important; }
/* bars and in-page cards drawn over the content */
html[data-agl-root] [data-agl="bar"] {
  background-color: color-mix(in srgb, rgb(var(--agl-c)) {{bar_over}}%, transparent) !important; }
/* under a full-window overlay that is glass now: hidden while it stays (it covered it before) */
html[data-agl-root] [data-agl-under] { visibility: hidden !important; }

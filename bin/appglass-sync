#!/bin/sh
# appglass-sync: keep every glass app in sync with DMS.
# Installed by `appglass hook install` (through ~/.local/bin/appglass-sync):
#  - appglass-sync.service (appglass-sync.path: the DMS window rules, the
#    opacity, or the DMS colours changed) runs it with no argument;
#  - appglass-sync.timer runs the same service once a day (apps that update
#    themselves, a missed event); the path unit also fires on app installs
#    (rpmdb, /usr/share/applications, flatpak .changed, user launchers);
#  - appglass-verify.service runs it with --verify: the queued headless checks
#    (appglass verify --queue), idle, never while a game runs;
#  - appglass-discord.service (appglass-discord.path: something changed in
#    ~/.config/discord, which Discord writes all the time) runs it with
#    --discord: it exits at once unless the newest Discord host dir (app-x.y.z,
#    after an update) has no Vencord.
#  1. Discord: put Vencord back in the newest host dir with
#     ~/.local/share/appglass/VencordInstallerCli-linux, only while the vencord
#     family is applied (state.json)
#  2. appglass apply --from-hook: re-render every applied family with the new
#     level and colours (launchers, CSS, the Discord theme, the niri rules)
#  3. only when one of their files changed: reload Herdr's theme, nudge the
#     running GTK3 apps to re-read their theme (a GTK theme flip)
# Undo: appglass hook remove.
set -u
AG="${APPGLASS_BIN:-$(dirname "$(readlink -f "$0")")/appglass}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/appglass/state.json"
SHARE="$HOME/.local/share/appglass"
DISCORD="${XDG_CONFIG_HOME:-$HOME/.config}/discord"
GTK3_CSS="${XDG_DATA_HOME:-$HOME/.local/share}/themes/AppGlass/gtk-3.0/gtk.css"
MODE=all
[ "${1:-}" = "--discord" ] && MODE=discord
if [ "${1:-}" = "--verify" ]; then
    exec "$AG" verify --queue
fi
RPMDB="${APPGLASS_RPMDB:-/usr/lib/sysimage/rpm/rpmdb.sqlite}"

# journald reads a <5> prefix as notice (the Discord unit keeps info out)
log() { if [ -n "${INVOCATION_ID:-}" ]; then echo "<5>appglass-sync: $*"; else echo "appglass-sync: $*"; fi; }
real() { [ -z "${APPGLASS_SANDBOX:-}" ]; }   # desktop side effects: never in a sandbox

# the newest Discord host dir when it still needs Vencord, else nothing
needs_vencord() {
    jq -e '.owners.vencord' "$STATE" >/dev/null 2>&1 || return 1
    [ -x "$SHARE/VencordInstallerCli-linux" ] || return 1
    app=$(ls -d "$DISCORD"/app-* 2>/dev/null | sort -V | tail -n 1)
    [ -n "$app" ] && [ -f "$app/resources/app.asar" ] && [ ! -f "$app/resources/_app.asar" ]
}

# --discord: Discord's own writes end here, before any lock, sleep or apply
if [ "$MODE" = discord ] && ! needs_vencord; then
    exit 0
fi

# the lock in a runtime dir only we can write to; no /tmp fallback. A
# sandboxed run locks inside its sandbox: it never waits on (or holds up)
# the real session's sync
RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
real || RT="$APPGLASS_SANDBOX"
if ! { [ -d "$RT" ] && [ ! -L "$RT" ] && [ -O "$RT" ]; } ||
        case $(stat -c %a "$RT" 2>/dev/null || echo 2) in *[2367] | *[2367]?) true ;; *) false ;; esac; then
    log "refusing: no private runtime dir ($RT) for the lock"
    exit 1
fi
exec 8>"$RT/appglass-sync.lock"
# a write after this (the lock wait and the settle included) is this event's;
# one per run: a run waiting on the lock must not move the holder's
START="$RT/appglass-sync.start.$$"
trap 'rm -f "$START"' EXIT
touch "$START"
flock -w 60 8 || exit 0
[ "$MODE" = discord ] || sleep "${APPGLASS_SYNC_SETTLE:-1}"   # let DMS finish writing
# a dnf transaction: wait until the rpm db had no change for 5 s (at most 60 s);
# sqlite writes the -wal and -shm files first, the db itself only at a checkpoint
if [ "$MODE" = all ] && [ -e "$RPMDB" ]; then
    quiet="${APPGLASS_RPMDB_QUIET:-5}"
    for _ in $(seq 1 60); do
        last=$(stat -c %Y "$RPMDB" "$RPMDB-wal" "$RPMDB-shm" 2>/dev/null | sort -n | tail -n 1)
        age=$(( $(date +%s) - ${last:-0} ))
        [ "$age" -ge "$quiet" ] && break
        sleep 1
    done
fi

# 1. Vencord in the newest Discord host dir
if needs_vencord; then
    sleep "${APPGLASS_SYNC_WAIT:-5}"   # the updater is still writing the new host
    if "$SHARE/VencordInstallerCli-linux" -install -location "$app" >/dev/null 2>&1; then
        log "Vencord injected into $app"
        if real && pgrep -x Discord >/dev/null 2>&1; then
            notify-send -a appGlass "Discord updated" "Vencord is back in. Restart Discord to get the glass back." 2>/dev/null
        fi
    else
        log "Vencord install failed for $app"
        real && notify-send -u critical -a appGlass "appGlass" "Could not put Vencord back into $app" 2>/dev/null
        [ "$MODE" = discord ] && exit 0
    fi
elif [ "$MODE" = discord ]; then
    exit 0      # injected meanwhile (another run)
fi

# 2. every applied family; the files it wrote, deleted or restored
changed=$("$AG" apply --from-hook --quiet --list-changed) || log "apply failed"
touched() { printf '%s\n' "$changed" | grep -q -e "$1"; }

# 3. Herdr and GTK, only for a change of theirs
if touched '/herdr-app/'; then
    if ! real; then
        log "herdr theme changed (no reload in a sandbox)"
    elif pgrep -x herdr-app >/dev/null 2>&1 && grep -q '"theme": *"appglass"' "$HOME/.config/herdr-app/layouts/appglass.json" 2>/dev/null; then
        herdr-app do app.theme --name appglass >/dev/null 2>&1
    fi
fi
# the matugen post_hook (apply --from-hook) of a colour change often writes
# the GTK3 theme during our settle: our apply then changes nothing, yet the
# running apps still need the flip
if touched '/gtk-[34]\.0/' || [ "$GTK3_CSS" -nt "$START" ]; then
    if ! real; then
        log "GTK CSS changed (no theme flip in a sandbox)"
    # GTK3 re-reads its theme (AppGlass) when the theme name changes; GTK4
    # reads gtk.css at start only
    elif t=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null) && [ -n "$t" ]; then
        # back to the theme read; a key the user never set (no dconf value)
        # is reset to its default, not pinned to the name read
        back() { gsettings set org.gnome.desktop.interface gtk-theme "$t" 2>/dev/null; }
        if command -v dconf >/dev/null 2>&1 \
                && v=$(dconf read /org/gnome/desktop/interface/gtk-theme 2>/dev/null) && [ -z "$v" ]; then
            back() { gsettings reset org.gnome.desktop.interface gtk-theme 2>/dev/null; }
        fi
        # a stop meanwhile (a logout, systemctl stop) puts the theme back first
        trap 'back; exit 143' TERM INT HUP
        gsettings set org.gnome.desktop.interface gtk-theme "''" 2>/dev/null
        sleep 0.3
        back
        trap - TERM INT HUP
    fi
fi
exit 0
